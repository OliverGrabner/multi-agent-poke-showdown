# Copy to configs/private/hprc.env (gitignored) and fill in. Never commit the real values.
HPRC_ACCOUNT=YOUR_SLURM_ACCOUNT
HPRC_GPU_PARTITION=gpu
HPRC_GPU_GRES=gpu:a100:2
HPRC_CPU_PARTITION=short
HPRC_CPUS=32
HPRC_MEM=180G
HPRC_TIME=24:00:00
# Empty installs the newest vLLM at setup time; the installed version is written to runs/setup-JOBID-packages.txt.
VLLM_VERSION=
